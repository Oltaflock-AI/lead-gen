# --- Required for scrapers + enrichment ---
GOOGLE_PLACES_API_KEY=

# --- Flask + Google OAuth (for Sheets + Gmail send) ---
# Create OAuth client at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: http://localhost:5001/auth/callback
# Enable APIs: Sheets, Gmail
FLASK_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5001/auth/callback

# --- Claude personalization for cold emails (optional; falls back to template) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Asana task creation from dashboard (optional) ---
# Get a Personal Access Token at https://app.asana.com/0/my-apps
# ASANA_WORKSPACE_GID is optional — if omitted, the first workspace is used.
ASANA_PAT=
ASANA_WORKSPACE_GID=

# --- Resend transactional/cold email (optional alternative to Gmail) ---
# https://resend.com/api-keys — domain in From must be verified in Resend
RESEND_API_KEY=
RESEND_FROM=

# ── Prospeo decision-maker enrichment (person-level data) ──
# API key for api.prospeo.io (person/company enrichment). No key = step skipped.
PROSPEO_API_KEY=
# Max paid Prospeo API calls per enrich cron tick (credit-burn guard). 0 = off.
LEADGEN_PROSPEO_PER_TICK=2
# Decision-maker mode is opt-in PER CAMPAIGN, not via env. Add to the
# campaign's search_config JSON (stored in campaigns.notes):
#   {"decision_maker_mode": true,
#    "target_titles": ["owner", "founder", "director", "general manager", "partner"]}
# target_titles is optional — the list above is the default.

# MillionVerifier PAYG single-verify (pattern-guess email waterfall step)
MILLIONVERIFIER_API_KEY=
# Max MillionVerifier checks per enrich cron tick (checks, not finds; 0 disables)
LEADGEN_VERIFY_PER_TICK=20

# Meta Ad Library intent signal (lib/meta_ads.py). Uses the PUBLIC ad-library
# web endpoint (unofficial, fragile - official API has no US/CA/AU commercial
# coverage). OFF by default; set to 1 to let the research tick stamp
# signals.meta_ads onto engaged leads.
LEADGEN_ADLIB_ENABLED=0
# Max Ad Library checks per research tick (each check = ~2 polite web requests).
LEADGEN_ADLIB_PER_TICK=5
