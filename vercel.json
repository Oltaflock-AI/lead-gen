{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "runtime": "@vercel/python@4.5.0",
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/webhook/resend",  "destination": "/api/webhook/resend" },
    { "source": "/webhook/inbound", "destination": "/api/webhook/inbound" },
    { "source": "/((?!api/).*)",    "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/daily_scrape", "schedule": "0 8 * * *" },
    { "path": "/api/cron/daily_digest", "schedule": "0 16 * * *" }
  ]
}
