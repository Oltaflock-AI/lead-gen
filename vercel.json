{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "runtime": "@vercel/python@4.5.0",
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/cron/daily_scrape", "schedule": "0 8 * * *" },
    { "path": "/api/cron/daily_digest", "schedule": "0 16 * * *" }
  ]
}
